# Web3Forms access key for the RFQ form (Phase 6). It is public by design (sent from the browser).
PUBLIC_WEB3FORMS_KEY=
# Show [[TODO]] placeholders in a production build (the github.io preview sets this to true).
PUBLIC_SHOW_TODOS=false
# Set to true only once the Web3Forms plan accepts file attachments; shows the drawing upload field.
PUBLIC_WEB3FORMS_ATTACHMENTS=false
