---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getProducts } from '../../lib/content';
import { url } from '../../lib/paths';
import { whatsappHref } from '../../lib/whatsapp';

// Request-a-quote form (site-plan §3). Sends to Web3Forms from the browser (rfq-form.ts).
// Drawing uploads need a paid Web3Forms plan, so the upload field appears only when
// PUBLIC_WEB3FORMS_ATTACHMENTS=true; otherwise buyers are told to send drawings on WhatsApp or email.
interface Props {
  variant?: 'compact' | 'full';
  product?: string; // pre-selected product slug
  id?: string;
}
const { variant = 'compact', product, id = 'rfq-form' } = Astro.props;
const full = variant === 'full';
const f = (name: string) => `${id}-${name}`;
const attachments = import.meta.env.PUBLIC_WEB3FORMS_ATTACHMENTS === 'true';

const rfqProducts = [
  ...(await getProducts()).map((p) => ({ value: p.id, label: p.data.shortName })),
  { value: 'custom-shape', label: 'Custom shape' },
  { value: 'other', label: 'Other' },
];

const label = 'text-[14px] leading-[1.2] font-semibold text-ink';
const field =
  'h-13 w-full rounded-sm border border-field-border bg-white px-3.5 text-[16px] text-ink placeholder:text-caption focus-visible:border-flame aria-invalid:border-flame aria-invalid:border-2';
const error = 'hidden text-[14px] font-semibold text-flame';
---
<form
  id={id}
  class="grid grid-cols-1 gap-5 md:grid-cols-2"
  method="post"
  action="https://api.web3forms.com/submit"
  novalidate
  data-rfq-form
  data-variant={variant}
  data-thanks={url('/thank-you/')}
  data-whatsapp={whatsappHref() ?? ''}
>
  <!-- Spam trap: people never see or tick this. -->
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="flex flex-col gap-2">
    <label for={f('product')} class={label}>Product <span aria-hidden="true">*</span></label>
    <select id={f('product')} name="product" required aria-describedby={f('product-error')} class:list={[field, 'appearance-auto']}>
      <option value="" disabled selected={!product}>Choose a product</option>
      {rfqProducts.map((p) => <option value={p.value} selected={p.value === product}>{p.label}</option>)}
    </select>
    <p id={f('product-error')} class={error} data-error-for="product">Choose a product.</p>
  </div>
  <div class="flex flex-col gap-2">
    <label for={f('qty')} class={label}>Quantity</label>
    <input id={f('qty')} name="quantity" type="text" placeholder="e.g. 2,000 pcs / month" class={field} />
  </div>
  <div class="flex flex-col gap-2">
    <label for={f('name')} class={label}>Name <span aria-hidden="true">*</span></label>
    <input id={f('name')} name="name" type="text" required autocomplete="name" aria-describedby={f('name-error')} class={field} />
    <p id={f('name-error')} class={error} data-error-for="name">Enter your name.</p>
  </div>
  <div class="flex flex-col gap-2">
    <label for={f('company')} class={label}>Company</label>
    <input id={f('company')} name="company" type="text" autocomplete="organization" class={field} />
  </div>
  <div class="flex flex-col gap-2">
    <label for={f('phone')} class={label}>Phone <span aria-hidden="true">*</span></label>
    <input
      id={f('phone')}
      name="phone"
      type="tel"
      required
      autocomplete="tel"
      inputmode="tel"
      placeholder="+91"
      aria-describedby={f('phone-error')}
      class={field}
    />
    <p id={f('phone-error')} class={error} data-error-for="phone">Enter a phone number with at least 10 digits.</p>
    <label class="flex min-h-11 items-center gap-2 text-[14px] leading-[1.2] text-body lg:min-h-6">
      <input type="checkbox" name="whatsapp_ok" value="Yes" checked class="h-[18px] w-[18px] accent-flame" />
      Reply on WhatsApp is fine
    </label>
  </div>
  <div class="flex flex-col gap-2">
    <label for={f('email')} class={label}>Email</label>
    <input id={f('email')} name="email" type="email" autocomplete="email" aria-describedby={f('email-error')} class={field} />
    <p id={f('email-error')} class={error} data-error-for="email">Enter a valid email address, or leave it blank.</p>
  </div>
  {
    full && (
      <div class="flex flex-col gap-2 md:col-span-2">
        <label for={f('city')} class={label}>Delivery city / country</label>
        <input id={f('city')} name="delivery" type="text" autocomplete="address-level2" class={field} />
      </div>
    )
  }
  {
    attachments ? (
      <div class="flex flex-col gap-2 md:col-span-2">
        <span id={f('file-label')} class={label}>Drawing or photo</span>
        <input
          id={f('file')}
          name="attachment"
          type="file"
          multiple
          accept=".pdf,.dwg,.dxf,.step,.stp,.jpg,.jpeg,.png"
          aria-labelledby={f('file-label')}
          aria-describedby={f('file-error')}
          class="peer sr-only"
          data-file-input
        />
        <label
          for={f('file')}
          class="flex min-h-24 cursor-pointer flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-sm border-[1.5px] border-dashed border-field-border bg-field-bg px-4 py-4 text-center text-[15px] text-body peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-flame hover:border-ink"
        >
          <Icon name="upload" size={22} />
          <span data-file-summary>Drop files or <span class="font-semibold text-flame">browse</span> · PDF, DWG, DXF, STEP, JPG · up to 25 MB</span>
        </label>
        <p id={f('file-error')} class={error} data-error-for="attachment">Files must be PDF, DWG, DXF, STEP, JPG or PNG, 25 MB in total.</p>
      </div>
    ) : (
      <p class="flex items-start gap-3 rounded-sm border-[1.5px] border-dashed border-field-border bg-field-bg px-4 py-4 text-[15px] text-body md:col-span-2">
        <Icon name="upload" size={22} class="mt-0.5" />
        <span>Have a drawing or photo? After you send this form, share it on WhatsApp or by email with your reference number.</span>
      </p>
    )
  }
  <div class="flex flex-col gap-2 md:col-span-2">
    <label for={f('msg')} class={label}>Details</label>
    <textarea
      id={f('msg')}
      name="details"
      rows={full ? 5 : 3}
      placeholder="Metal and pouring temperature, size, delivery location…"
      class="w-full resize-y rounded-sm border border-field-border bg-white p-3.5 text-[16px] leading-[1.35] text-ink placeholder:text-caption focus-visible:border-flame"
    ></textarea>
  </div>
  {
    full && (
      <p class="text-[14px] text-body md:col-span-2">
        By sending this form you agree to us using these details to prepare your quote. See our{' '}
        <a href={url('/privacy/')} class="text-flame underline hover:text-flame-hover">privacy notice</a>.
      </p>
    )
  }
  <div class="flex flex-col gap-4 md:col-span-2 md:flex-row md:items-center md:gap-5">
    <Button type="submit" size="lg" data-submit data-event="rfq_submit">Request quote</Button>
    <span class="font-mono text-[12px] text-caption">You’ll get a reference number as soon as you send it.</span>
  </div>
  <div role="alert" tabindex="-1" class="hidden rounded-sm border-2 border-flame bg-white p-4 text-[15px] text-ink md:col-span-2" data-form-error>
    <p class="font-semibold">Your request didn’t send. Nothing you typed has been lost.</p>
    <p class="mt-1 text-body">Please try again, or send it to us on WhatsApp instead.</p>
    <a href="#" class="mt-3 inline-flex min-h-11 items-center gap-2 font-semibold text-flame underline hover:text-flame-hover" data-whatsapp-fallback>
      <Icon name="whatsapp" size={18} /> Send on WhatsApp
    </a>
  </div>
</form>

<script>
  import { initRfqForms } from './rfq-form';
  initRfqForms();
</script>
