---
import PhotoFrame from '../ui/PhotoFrame.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  name: string;
  summary: string;
  photo?: ImageMetadata;
  photoAlt?: string;
}
const { href, name, summary, photo, photoAlt } = Astro.props;
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-sm border border-line-light bg-white text-ink transition-colors duration-150 hover:border-flame"
>
  <div class="h-32 overflow-hidden md:h-44">
    <PhotoFrame
      src={photo}
      alt={photoAlt}
      caption="studio"
      tone="light"
      sizes="(min-width: 1024px) 20vw, 50vw"
      class="h-full rounded-none border-0 p-3 transition-transform duration-150 motion-safe:group-hover:scale-[1.02]"
    />
  </div>
  <div class="flex flex-col gap-1.5 px-4 pt-4 pb-5 md:px-[18px] md:pt-[18px]">
    <span class="text-[17px] font-semibold md:text-[18px]">{name}</span>
    <span class="text-[14px] leading-[1.45] text-body">{summary}</span>
  </div>
</a>
