---
import Icon from '../ui/Icon.astro';

// <details>/<summary> rows with hairlines and a plus/minus icon. No JS.
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---
<div class:list={['border-t border-line-light', className]}>
  {
    items.map((item) => (
      <details class="group border-b border-line-light">
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 text-[17px] font-semibold text-ink [&::-webkit-details-marker]:hidden">
          {item.q}
          <Icon name="plus" class="text-flame group-open:hidden" />
          <Icon name="minus" class="hidden text-flame group-open:block" />
        </summary>
        <p class="max-w-[68ch] pb-6 text-copy text-body">{item.a}</p>
      </details>
    ))
  }
</div>
