---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import PhotoFrame from '../ui/PhotoFrame.astro';
import TemperatureRuler from '../ui/TemperatureRuler.astro';
import type { ImageMetadata } from 'astro';

// Home hero: 7/5 split, three actions, photo with the "Quote reply" badge, ruler along the bottom.
interface Props {
  eyebrow: string;
  lead: string;
  primary: { href: string; label: string };
  secondary: { href: string; label: string };
  whatsapp?: string | null;
  photo?: ImageMetadata;
  photoAlt?: string;
  photoCaption: string;
  badge?: { label: string; value: string } | null;
}
const { eyebrow, lead, primary, secondary, whatsapp, photo, photoAlt, photoCaption, badge } = Astro.props;
---
<section class="on-dark relative bg-carbon" aria-labelledby="hero-title">
  <div class="container-site grid gap-12 pt-12 pb-24 lg:grid-cols-12 lg:gap-x-6 lg:pt-18 lg:pb-32">
    <div class="flex flex-col gap-6 lg:col-span-7 lg:gap-7 lg:pt-6">
      <Eyebrow tone="dark">{eyebrow}</Eyebrow>
      <h1 id="hero-title" class="font-display text-display font-bold text-text-on-dark uppercase">
        <slot />
      </h1>
      <p class="max-w-[620px] text-lead text-body-on-dark">{lead}</p>
      <div class="flex flex-col gap-3 pt-2 md:flex-row md:flex-wrap md:items-center md:gap-4">
        <Button href={primary.href} size="lg" trailingIcon="arrow-right">{primary.label}</Button>
        <Button href={secondary.href} size="lg" variant="outline-dark">{secondary.label}</Button>
        {whatsapp && <Button href={whatsapp} size="lg" variant="text-dark" icon="whatsapp">WhatsApp us</Button>}
      </div>
    </div>
    <div class="relative h-80 md:h-[440px] lg:col-span-5 lg:h-[560px]">
      <PhotoFrame
        src={photo}
        alt={photoAlt}
        caption={photoCaption}
        captionPosition="top"
        loading="eager"
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="absolute inset-0 p-5"
      />
      {
        badge && (
          <div class="absolute bottom-6 left-4 flex flex-col gap-1 border border-line-dark bg-carbon px-5 py-4 lg:bottom-12 lg:-left-8">
            <span class="font-mono text-[11px] tracking-[0.16em] text-faint-on-dark uppercase">{badge.label}</span>
            <span class="font-display text-[22px] font-semibold text-text-on-dark lg:text-[26px]">{badge.value}</span>
          </div>
        )
      }
    </div>
  </div>
  <div class="container-site absolute inset-x-0 bottom-7">
    <TemperatureRuler />
  </div>
</section>
