---
// A carbon panel spanning 4 columns inside a light grid (filter-candle applications).
interface Props {
  title: string;
  text: string;
  items: string[];
  itemsLabel?: string;
  class?: string;
}
const { title, text, items, itemsLabel = 'Applications', class: className } = Astro.props;
---
<div
  class:list={[
    'on-dark col-span-2 flex flex-col gap-8 rounded-sm bg-carbon px-6 py-8 md:flex-row md:items-center md:justify-between md:gap-10 lg:col-span-4 lg:px-10 lg:py-9',
    className,
  ]}
>
  <div class="flex max-w-[520px] flex-col gap-3">
    <p class="font-display text-[26px] leading-[1.05] font-semibold text-text-on-dark uppercase lg:text-[32px]">{title}</p>
    <p class="text-[16px] leading-[1.55] text-body-on-dark">{text}</p>
  </div>
  <ul class="flex shrink-0 flex-col gap-2.5 font-mono text-[13px] text-ice" aria-label={itemsLabel}>
    {items.map((item) => <li><span aria-hidden="true">→ </span>{item}</li>)}
  </ul>
</div>
