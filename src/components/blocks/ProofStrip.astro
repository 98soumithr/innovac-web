---
import { isTodo } from '../../data/site';

// Four stats on carbon-2. A stat with no value isn't rendered; with none, the strip isn't either.
export interface Stat {
  value: string | null;
  unit?: string | null;
  label: string;
}
interface Props {
  stats: Stat[];
}
const stats = Astro.props.stats.filter((s) => s.value);
const lgCols = ['', 'lg:grid-cols-1', 'lg:grid-cols-2', 'lg:grid-cols-3', 'lg:grid-cols-4'][Math.min(stats.length, 4)];
---
{
  stats.length > 0 && (
    <section class="on-dark border-y border-line-dark bg-carbon-2" aria-label="Company facts">
      <dl class:list={['container-site grid grid-cols-2', lgCols]}>
        {stats.map((s, i) => (
          <div
            class:list={[
              'flex flex-col-reverse gap-1.5 py-7 lg:py-9',
              i % 2 === 0 ? 'pr-4 lg:pr-8' : 'pl-4 lg:pl-8',
              i % 2 === 0 && 'border-r border-line-dark',
              i >= 2 && 'max-lg:border-t max-lg:border-line-dark',
              'lg:border-r lg:border-line-dark lg:px-8 lg:first:pl-0 lg:last:border-r-0 lg:last:pr-0',
            ]}
          >
            <dt class="font-mono text-[11px] tracking-[0.12em] text-muted-on-dark uppercase lg:text-[12px]">{s.label}</dt>
            {isTodo(s.value) ? (
              <dd class="flex min-h-[1em] items-end font-mono text-[13px] text-ice lg:min-h-[52px]">{s.value}</dd>
            ) : (
              <dd class="font-display text-stat font-semibold break-words text-text-on-dark">
                {s.value}
                {s.unit && <span class="text-[0.5em] text-ice"> {s.unit}</span>}
              </dd>
            )}
          </div>
        ))}
      </dl>
    </section>
  )
}
