---
interface Props {
  href: string;
  title: string;
  products: string;
}
const { href, title, products } = Astro.props;
---
<a
  href={href}
  class="flex flex-col gap-3 rounded-sm border border-line-light bg-white px-6 py-7 text-ink transition-colors duration-150 hover:border-flame md:min-h-40 lg:min-h-50"
>
  <span class="font-display text-[24px] leading-[1.05] font-semibold uppercase lg:text-[26px]">{title}</span>
  <span class="font-mono text-[12px] leading-[1.6] text-caption">{products}</span>
</a>
