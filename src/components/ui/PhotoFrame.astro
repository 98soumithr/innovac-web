---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Real photos render through <Picture> (AVIF + WebP). With no `src`, a hatched placeholder shows the
// exact photo still needed (design-system §4.5). No stock or AI images, ever.
interface Props {
  src?: ImageMetadata;
  alt?: string;
  caption: string; // what the photo must show, e.g. "plant floor, wide"
  tone?: 'dark' | 'light';
  captionPosition?: 'top' | 'bottom';
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const {
  src,
  alt = '',
  caption,
  tone = 'dark',
  captionPosition = 'bottom',
  sizes = '(min-width: 1280px) 50vw, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
---
{
  src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      sizes={sizes}
      widths={[480, 800, 1200, 1600, 2400]}
      loading={loading}
      class:list={['h-full w-full rounded-sm object-cover', className]}
    />
  ) : (
    <div
      role="img"
      aria-label={`Photo placeholder: ${caption}`}
      class:list={[
        'flex rounded-sm border p-4',
        tone === 'dark' ? 'hatch-dark border-line-dark' : 'hatch-light border-line-light',
        captionPosition === 'top' ? 'items-start' : 'items-end',
        className,
      ]}
    >
      <span
        class:list={[
          'font-mono text-[11px] leading-snug tracking-[0.08em] md:text-[12px]',
          tone === 'dark' ? 'text-faint-on-dark' : 'text-caption',
        ]}
      >
        [PHOTO — {caption}]
      </span>
    </div>
  )
}
