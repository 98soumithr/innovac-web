---
import { SHOW_TODOS } from '../../data/site';
import { BRAND } from '../../lib/brand';
import { ogSlugFor } from '../../lib/og';
import { organizationLd } from '../../lib/seo';
import { url } from '../../lib/paths';

// Head tags for every page (site-plan §4.3–4.4): title, description, canonical, OG/Twitter with a
// build-time image, and the site-wide Organization / LocalBusiness JSON-LD. Pages add their own
// JSON-LD (Product, BreadcrumbList) through `jsonLd`.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const site = Astro.site!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(url(`/og/${await ogSlugFor(path)}.png`), site).href;
// The github.io preview must never be indexed.
const robots = noindex || (SHOW_TODOS && !import.meta.env.DEV) ? 'noindex, nofollow' : undefined;
const graphs = [organizationLd(site), ...jsonLd];
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Innovac Ceramic" />
<meta property="og:locale" content="en_IN" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content={BRAND.carbon} />
{graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
