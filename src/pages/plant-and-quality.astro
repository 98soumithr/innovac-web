---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/blocks/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PhotoFrame from '../components/ui/PhotoFrame.astro';
import FactTile from '../components/ui/FactTile.astro';
import { site, fact, todo } from '../data/site';
import { url } from '../lib/paths';

const address = site.address
  ? [site.address.street, site.address.locality, `${site.address.city}, ${site.address.region} ${site.address.postalCode}`].filter(Boolean).join(', ')
  : fact(null, 'plant address');
const capacity = site.capacity ? `${site.capacity.value} ${site.capacity.unit}` : fact(null, 'capacity');
const area = fact(site.plantArea, 'plant area');
const checks = site.qualityChecks;
const checksTodo = checks.length ? null : todo('quality checks with method or instrument and frequency (site.ts → qualityChecks)');
const certTodo = site.certificates.length ? null : todo('certificates held: name, number, issuing body, PDF (only if held)');
const exportLine = site.exportApproved ? 'We also pack for export.' : todo('confirm whether export can be mentioned');
---
<PageLayout
  title="Ceramic Fibre Products Manufacturer, Hyderabad | Innovac"
  description="Our Hyderabad plant makes and checks ceramic fibre shapes, foundry consumables and filter candles. Test report with every order. Request a quote."
  breadcrumbs={[{ label: 'Plant & Quality' }]}
>
  <PageHero
    eyebrow="Plant & Quality"
    title="Made and checked in our own plant"
    lead="We are a ceramic fibre products manufacturer in Hyderabad. Every part is measured and checked against the approved spec before it ships."
  />

  <Section tone="paper" aria-labelledby="plant-title" innerClass="grid gap-12 lg:grid-cols-12 lg:gap-x-6">
    <div class="flex flex-col gap-6 lg:col-span-5">
      <SectionHeader eyebrow="The plant" id="plant-title">Hyderabad, India</SectionHeader>
      <dl class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-1">
        {[['Address', address], ['Capacity', capacity], ['Plant area', area]].filter(([, v]) => v).map(([k, v]) => (
          <div class="flex flex-col gap-1 border-t border-line-light pt-3">
            <dt class="font-mono text-[11px] tracking-[0.14em] text-caption uppercase">{k}</dt>
            <dd class="text-[16px] text-ink">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="grid grid-cols-2 gap-3 md:gap-4 lg:col-span-7">
      <PhotoFrame caption="plant floor, wide" tone="light" class="col-span-2 h-56 md:h-80" />
      <PhotoFrame caption="finished goods on racks" tone="light" class="h-36 md:h-52" />
      <PhotoFrame caption="stores" tone="light" class="h-36 md:h-52" />
    </div>
  </Section>

  <Section tone="carbon" aria-labelledby="checks-title" innerClass="flex flex-col gap-10">
    <SectionHeader eyebrow="Quality checks" tone="dark" id="checks-title">What we check</SectionHeader>
    <div class="overflow-x-auto" role="region" aria-labelledby="checks-title" tabindex="0">
      <table class="w-full min-w-[560px] border-collapse text-left">
        <thead>
          <tr class="border-b border-line-dark-strong">
            {['Check', 'Method or instrument', 'Frequency'].map((h) => <th scope="col" class="py-3 pr-4 font-mono text-[12px] font-normal tracking-[0.12em] text-muted-on-dark uppercase">{h}</th>)}
          </tr>
        </thead>
        <tbody class="font-mono text-data">
          {checks.map((c) => (
            <tr class="border-b border-line-dark">
              <th scope="row" class="py-4 pr-4 font-normal text-text-on-dark">{c.label}</th>
              <td class="py-4 pr-4 text-body-on-dark">{fact(c.method, 'method')}</td>
              <td class="py-4 text-body-on-dark">{fact(c.frequency, 'frequency')}</td>
            </tr>
          ))}
          {checksTodo && <tr class="border-b border-line-dark"><td colspan="3" class="py-4 text-ice">{checksTodo}</td></tr>}
        </tbody>
      </table>
    </div>
  </Section>

  <Section tone="white" aria-labelledby="cert-title" innerClass="grid gap-12 lg:grid-cols-2 lg:gap-x-6">
    <div class="flex flex-col gap-6">
      <SectionHeader eyebrow="Certificates" id="cert-title">Certificates and test reports</SectionHeader>
      <div class="grid gap-4 md:grid-cols-2">
        {site.certificates.map((c) => (
          <FactTile tone="light" value={c.name} label={`${c.issuedBy} · No. ${c.number}`} />
        ))}
        {certTodo && <FactTile tone="light" value={certTodo} label="Certificate" />}
        <FactTile tone="light" value="Test report" label="With every order, on request" />
      </div>
      {site.certificates.some((c) => c.pdf) && (
        <a href={url('/downloads/')} class="font-semibold text-flame hover:text-flame-hover hover:underline">Download certificates</a>
      )}
    </div>
    <div class="flex flex-col gap-6">
      <SectionHeader eyebrow="Packing & dispatch">Packed to arrive whole</SectionHeader>
      <ul class="border-t border-line-light text-[16px] text-body">
        <li class="border-b border-line-light py-4">Packed in cartons, palletised for larger orders.</li>
        <li class="border-b border-line-light py-4">Every carton labelled with the part, quantity and your order reference.</li>
        <li class="border-b border-line-light py-4">Delivery across India.</li>
        {exportLine && <li class="border-b border-line-light py-4">{exportLine}</li>}
      </ul>
    </div>
  </Section>
</PageLayout>
