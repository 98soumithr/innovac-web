---
// Visual QA of every component (noindex; disallowed in robots.txt).
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import TemperatureRuler from '../components/ui/TemperatureRuler.astro';
import PhotoFrame from '../components/ui/PhotoFrame.astro';
import FactTile from '../components/ui/FactTile.astro';
import Wordmark from '../components/layout/Wordmark.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ProofStrip from '../components/blocks/ProofStrip.astro';
import ProductFamily from '../components/blocks/ProductFamily.astro';
import ProductCard from '../components/blocks/ProductCard.astro';
import CustomCard from '../components/blocks/CustomCard.astro';
import FeaturePanel from '../components/blocks/FeaturePanel.astro';
import QualityChecks from '../components/blocks/QualityChecks.astro';
import IndustryTile from '../components/blocks/IndustryTile.astro';
import SpecTable from '../components/blocks/SpecTable.astro';
import SizesTable from '../components/blocks/SizesTable.astro';
import FaqList from '../components/blocks/FaqList.astro';
import RfqBand from '../components/blocks/RfqBand.astro';
import ContactPanel from '../components/blocks/ContactPanel.astro';
import DownloadList from '../components/blocks/DownloadList.astro';
import RfqForm from '../components/forms/RfqForm.astro';
import { filtrationFeature } from '../data/home';
import { getProductsByFamily, getIndustries } from '../lib/content';
import { url } from '../lib/paths';

const families = (await getProductsByFamily()).map(({ family, products }) => ({
  title: family.data.title,
  products: products.map((p) => ({ slug: p.id, name: p.data.shortName, summary: p.data.summary })),
}));
const industries = (await getIndustries()).map((i) => ({ slug: i.id, title: i.data.shortName, products: i.data.tileProducts }));
const icons = ['arrow-right', 'chevron', 'whatsapp', 'upload', 'download', 'menu', 'close', 'plus', 'minus', 'check'] as const;
const colours = [
  'carbon', 'carbon-2', 'carbon-3', 'line-dark', 'line-dark-strong', 'body-on-dark', 'muted-on-dark',
  'faint-on-dark', 'flame', 'flame-hover', 'ice', 'paper', 'white', 'line-light', 'line-light-strong',
  'placeholder-light', 'field-border', 'field-bg', 'ink', 'body', 'caption', 'nav-link', 'on-flame-muted',
];
// Swatch classes spelled out so Tailwind generates them.
const swatch: Record<string, string> = {
  carbon: 'bg-carbon', 'carbon-2': 'bg-carbon-2', 'carbon-3': 'bg-carbon-3', 'line-dark': 'bg-line-dark',
  'line-dark-strong': 'bg-line-dark-strong', 'body-on-dark': 'bg-body-on-dark', 'muted-on-dark': 'bg-muted-on-dark',
  'faint-on-dark': 'bg-faint-on-dark', flame: 'bg-flame', 'flame-hover': 'bg-flame-hover', ice: 'bg-ice',
  paper: 'bg-paper', white: 'bg-white', 'line-light': 'bg-line-light', 'line-light-strong': 'bg-line-light-strong',
  'placeholder-light': 'bg-placeholder-light', 'field-border': 'bg-field-border', 'field-bg': 'bg-field-bg',
  ink: 'bg-ink', body: 'bg-body', caption: 'bg-caption', 'nav-link': 'bg-nav-link', 'on-flame-muted': 'bg-on-flame-muted',
};
const sampleSpecs = [
  { property: 'Classification temperature', value: '1260 °C (sample)', method: 'sample method' },
  { property: 'Bulk density', value: '300 kg/m³ (sample)' },
  { property: 'Hidden row (null value)', value: null },
];
const faqs = [
  { q: 'Sample question: can you make this to my drawing?', a: 'Sample answer text for the styleguide only. Real FAQs live in the content files.' },
  { q: 'Sample question: what do you need to quote?', a: 'Sample answer: size, quantity and the application.' },
];
---
<BaseLayout title="Styleguide | Innovac Ceramic" noindex>
  <Section tone="carbon">
    <SectionHeader eyebrow="Styleguide" tone="dark">Blue Flame components</SectionHeader>
    <p class="mt-4 max-w-[68ch] text-copy">Every component in every variant, on carbon and paper. Sample values on this page are not facts.</p>
  </Section>

  <Section tone="paper">
    <SectionHeader eyebrow="01 — Colour tokens">Colours</SectionHeader>
    <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-6">
      {colours.map((c) => (
        <li class="flex flex-col gap-2">
          <span class:list={['h-16 rounded-sm border border-line-light', swatch[c]]}></span>
          <span class="font-mono text-[12px] text-caption">{c}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="white">
    <SectionHeader eyebrow="02 — Type">Type scale</SectionHeader>
    <div class="mt-10 flex flex-col gap-6 text-ink">
      <p class="font-display text-display font-bold uppercase">Display H1 <span class="text-flame">accent</span></p>
      <p class="font-display text-h2 font-bold uppercase">H2 section heading</p>
      <p class="font-display text-h3 font-semibold uppercase">H3 heading</p>
      <p class="font-display text-stat font-semibold">1,234</p>
      <p class="max-w-[60ch] text-lead text-body">Lead text in Barlow 400, 18 to 20px, for the sentence under a headline.</p>
      <p class="max-w-[68ch] text-copy text-body">Body text in Barlow 400, 16 to 17px. Short sentences, written as the maker.</p>
      <p class="text-small text-body">Small text, 15px.</p>
      <Eyebrow>Eyebrow · mono 13px</Eyebrow>
      <p class="font-mono text-data text-ink tabular-nums">Data / specs · 1260 °C · 300 kg/m³</p>
    </div>
  </Section>

  <Section tone="carbon">
    <SectionHeader eyebrow="03 — Buttons on dark" tone="dark">Buttons</SectionHeader>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button size="lg" trailingIcon="arrow-right">Primary large</Button>
      <Button>Primary</Button>
      <Button variant="outline-dark" size="lg">Outline dark</Button>
      <Button variant="outline-flame" size="field" icon="whatsapp">Outline flame</Button>
      <Button variant="text-dark" icon="whatsapp" size="lg">Text on dark</Button>
      <Button disabled>Disabled</Button>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-6 text-ice">
      {icons.map((i) => <span class="flex items-center gap-2 font-mono text-[12px]"><Icon name={i} />{i}</span>)}
    </div>
    <div class="mt-10 flex flex-wrap items-end gap-10">
      <Wordmark />
      <Wordmark size="sm" />
    </div>
    <div class="mt-10"><Breadcrumbs items={[{ label: 'Products', href: '/products/' }, { label: 'Foundry consumables', href: '/products/foundry-consumables/' }, { label: 'Sampling spoons' }]} /></div>
    <div class="mt-10"><TemperatureRuler /></div>
  </Section>

  <Section tone="paper">
    <SectionHeader eyebrow="04 — Buttons on light">Buttons</SectionHeader>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button size="lg" trailingIcon="arrow-right">Primary large</Button>
      <Button variant="outline-light" size="lg">Outline light</Button>
      <Button variant="text-light">Text on light</Button>
      <Button variant="outline-light" disabled>Disabled</Button>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <FactTile tone="light" value="Test report" label="With every order, on request" />
      <FactTile tone="light" value="[sample]" label="Certificate · sample" />
    </div>
  </Section>

  <ProofStrip stats={[
    { value: '[YEAR]', label: 'Manufacturing since (sample)' },
    { value: '[X]', unit: 'pcs / month', label: 'Production capacity (sample)' },
    { value: '[N]+', label: 'Foundries & plants supplied (sample)' },
    { value: '11', label: 'Product lines + custom shapes (sample)' },
  ]} />

  <Section tone="paper">
    <SectionHeader eyebrow="05 — Products" link={{ href: url('/products/'), label: 'All products' }}>Product family</SectionHeader>
    <div class="mt-14 flex flex-col gap-14">
      <ProductFamily letter="A" title={families[0].title} href={url('/products/foundry-consumables/')}>
        {families[0].products.map((p) => <ProductCard href={url(`/products/${p.slug}/`)} name={p.name} summary={p.summary} />)}
      </ProductFamily>
      <ProductFamily letter="B" title={families[1].title}>
        {families[1].products.map((p) => <ProductCard href={url(`/products/${p.slug}/`)} name={p.name} summary={p.summary} />)}
        <FeaturePanel title={filtrationFeature.title} text={filtrationFeature.text} items={filtrationFeature.applications} />
      </ProductFamily>
      <ProductFamily letter="C" title={families[2].title} href={url('/products/thermal-insulation/')}>
        {families[2].products.map((p) => <ProductCard href={url(`/products/${p.slug}/`)} name={p.name} summary={p.summary} />)}
        <CustomCard href={url('/custom-ceramic-fibre-shapes/')} class="col-span-2 md:col-span-1" />
      </ProductFamily>
    </div>
  </Section>

  <Section tone="carbon">
    <SectionHeader eyebrow="06 — Quality" tone="dark">Checks, tiles and photos</SectionHeader>
    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <div class="flex flex-col gap-8">
        <QualityChecks />
        <QualityChecks checks={[{ label: 'Sample check', method: null, frequency: null }, { label: 'Another sample check', method: null, frequency: null }]} />
        <div class="grid grid-cols-2 gap-4">
          <FactTile value="[sample]" label="Certificate · sample" />
          <FactTile value="Test report" label="With every order, on request" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <PhotoFrame caption="plant floor, wide" class="col-span-2 h-72" />
        <PhotoFrame caption="QC bench" class="h-44" />
        <PhotoFrame caption="packed goods" tone="light" class="h-44" />
      </div>
    </div>
  </Section>

  <Section tone="paper">
    <SectionHeader eyebrow="07 — Industries">Industry tiles</SectionHeader>
    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-5">
      {industries.map((i) => <IndustryTile href={url(`/industries/${i.slug}/`)} title={i.title} products={i.products} />)}
    </div>
  </Section>

  <Section tone="white">
    <SectionHeader eyebrow="08 — Data">Tables, FAQ and downloads</SectionHeader>
    <div class="mt-12 grid gap-12 lg:grid-cols-2">
      <SpecTable rows={sampleSpecs} />
      <SizesTable columns={['Part no.', 'Length', 'Diameter', 'Wall']} rows={[['SAMPLE-01', '100 mm', '40 mm', '6 mm'], ['SAMPLE-02', '150 mm', '50 mm', '8 mm']]} />
    </div>
    <FaqList items={faqs} class="mt-12" />
    <div class="mt-12">
      <DownloadList items={[
        { title: 'Sample datasheet', type: 'datasheet', file: null },
        { title: 'Sample company profile', type: 'profile', file: null },
      ]} />
    </div>
  </Section>

  <Section tone="white">
    <SectionHeader eyebrow="09 — Forms">Request a quote</SectionHeader>
    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-x-6">
      <div class="lg:col-span-7"><RfqForm id="sg-compact" /></div>
      <ContactPanel class="lg:col-span-4 lg:col-start-9 lg:self-start" />
    </div>
    <div class="mt-16 max-w-3xl"><RfqForm id="sg-full" variant="full" product="tap-out-cones" /></div>
  </Section>

  <RfqBand />
</BaseLayout>
