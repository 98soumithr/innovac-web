---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/blocks/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ContactPanel from '../components/blocks/ContactPanel.astro';
import RfqForm from '../components/forms/RfqForm.astro';
import { site, fact } from '../data/site';

const hours = fact(site.hours, 'working hours');
---
<PageLayout
  title="Contact Innovac Ceramic | Hyderabad Plant"
  description="Contact Innovac Ceramic by WhatsApp, phone or email for ceramic fibre shapes, foundry consumables and filter candles from Hyderabad. Request a quote."
  breadcrumbs={[{ label: 'Contact' }]}
  rfqBand={false}
>
  <PageHero eyebrow="Contact" title="Talk to the plant" lead="WhatsApp is the quickest way to reach us. For a quote, send the form with a drawing or your sizes.">
    {hours && <p class="font-mono text-[13px] text-muted-on-dark">Hours: <span class="text-ice">{hours}</span></p>}
  </PageHero>
  <Section tone="white" aria-labelledby="contact-form-title" innerClass="grid gap-12 lg:grid-cols-12 lg:gap-x-6">
    <div class="flex flex-col gap-8 lg:col-span-7">
      <SectionHeader eyebrow="Request a quote" id="contact-form-title">Tell us what you need</SectionHeader>
      <RfqForm id="contact-rfq" />
    </div>
    <ContactPanel class="lg:col-span-4 lg:col-start-9 lg:self-start" />
  </Section>
</PageLayout>
