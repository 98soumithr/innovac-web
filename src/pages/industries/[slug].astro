---
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProductCard from '../../components/blocks/ProductCard.astro';
import FaqList from '../../components/blocks/FaqList.astro';
import { getIndustries, getProducts, productPath, type Industry } from '../../lib/content';
import { validateContent } from '../../lib/validate';
import { url } from '../../lib/paths';

export async function getStaticPaths() {
  await validateContent();
  return (await getIndustries()).map((industry) => ({ params: { slug: industry.id }, props: { industry } }));
}

const { industry } = Astro.props as { industry: Industry };
const d = industry.data;
const { Content } = await render(industry);
const products = await getProducts();
const find = (slug: string) => products.find((p) => p.id === slug);
const used = [...new Set(d.problems.flatMap((p) => p.products))].map(find).filter((p) => p !== undefined);
---
<PageLayout
  title={d.seo.title}
  description={d.seo.description}
  breadcrumbs={[{ label: 'Industries', href: '/industries/' }, { label: d.shortName }]}
>
  <PageHero eyebrow={d.shortName} title={d.title}>
    <div class="prose-site max-w-[640px] text-lead text-body-on-dark [&_strong]:text-white"><Content /></div>
  </PageHero>

  <Section tone="white" aria-labelledby="problems-title" innerClass="flex flex-col gap-10">
    <SectionHeader eyebrow="Problems we solve" id="problems-title">What goes wrong, and the fix</SectionHeader>
    <ol class="grid gap-4 lg:grid-cols-3">
      {
        d.problems.map((p, i) => (
          <li class="flex flex-col gap-4 rounded-sm border border-line-light p-6 lg:p-8">
            <span class="font-mono text-[13px] text-caption">0{i + 1}</span>
            <h3 class="font-display text-h3 font-semibold text-ink uppercase">{p.problem}</h3>
            <p class="text-copy text-body">{p.answer}</p>
            <p class="mt-auto flex flex-wrap gap-x-4 gap-y-1 font-mono text-[12px]">
              {p.products.map((s) => {
                const prod = find(s);
                return prod ? (
                  <a href={url(productPath(s))} class="text-flame hover:text-flame-hover hover:underline">{prod.data.shortName} →</a>
                ) : null;
              })}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    used.length > 0 && (
      <Section tone="paper" aria-labelledby="used-title" innerClass="flex flex-col gap-10">
        <SectionHeader eyebrow="Products used" id="used-title">Parts for this industry</SectionHeader>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-4">
          {used.map((p) => <ProductCard href={url(productPath(p.id))} name={p.data.shortName} summary={p.data.summary} photo={p.data.images.hero} />)}
        </div>
      </Section>
    )
  }

  <Section tone="white" aria-labelledby="industry-faq" innerClass="grid gap-10 lg:grid-cols-12 lg:gap-x-6">
    <SectionHeader eyebrow="FAQ" id="industry-faq" class="lg:col-span-4">Questions buyers ask</SectionHeader>
    <FaqList items={d.faqs} class="lg:col-span-8" />
  </Section>
</PageLayout>
